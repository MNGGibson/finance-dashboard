<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace every /path/to/finance-dashboard below with this project's actual absolute path before loading. -->
<dict>
    <key>Label</key>
    <string>com.financedashboard.sync</string>

    <!-- run_sync.sh starts Docker if needed, syncs 14 days (card charges post late; upserts are idempotent) and raises a macOS notification on failure. -->
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/finance-dashboard/scripts/run_sync.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/finance-dashboard</string>

    <!-- Every 6 hours at a random-looking minute, as SimpleFIN suggests. Its limit is 24
         pulls a day; four catches each bank's daily refresh within hours. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>17</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/path/to/finance-dashboard/logs/sync.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/finance-dashboard/logs/sync.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
