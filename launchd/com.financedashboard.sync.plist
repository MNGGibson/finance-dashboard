<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace every /path/to/finance-dashboard below with this project's actual absolute path before loading. -->
<dict>
    <key>Label</key>
    <string>com.financedashboard.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/finance-dashboard/.venv/bin/python3</string>
        <string>/path/to/finance-dashboard/scripts/sync.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/finance-dashboard</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/path/to/finance-dashboard/logs/sync.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/finance-dashboard/logs/sync.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
