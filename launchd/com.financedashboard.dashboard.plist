<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace every /path/to/finance-dashboard below with this project's actual absolute path before loading.
     Keeps the Streamlit dashboard running on http://localhost:8511.
     Bound to localhost only: the app shows real bank data, so it is not exposed to the network.
     run_dashboard.sh starts Docker Desktop if it is not running before launching Streamlit. -->
<dict>
    <key>Label</key>
    <string>com.financedashboard.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/finance-dashboard/scripts/run_dashboard.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/finance-dashboard</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/path/to/finance-dashboard/logs/dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/finance-dashboard/logs/dashboard.err.log</string>
</dict>
</plist>
