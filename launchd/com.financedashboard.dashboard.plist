<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace every /path/to/finance-dashboard below with this project's actual absolute path before loading.
     Keeps the Streamlit dashboard running on http://localhost:8511.
     Bound to localhost only: the app shows real bank data, so it is not exposed to the network.
     Needs Docker (finance-postgres) to be running for data to load. -->
<dict>
    <key>Label</key>
    <string>com.financedashboard.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/finance-dashboard/.venv/bin/streamlit</string>
        <string>run</string>
        <string>app.py</string>
        <string>--server.port</string>
        <string>8511</string>
        <string>--server.address</string>
        <string>localhost</string>
        <string>--server.headless</string>
        <string>true</string>
        <string>--browser.gatherUsageStats</string>
        <string>false</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/finance-dashboard</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/path/to/finance-dashboard/logs/dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/finance-dashboard/logs/dashboard.err.log</string>
</dict>
</plist>
