POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Filled in automatically by `python scripts/setup.py <SIMPLEFIN_SETUP_TOKEN>`
SIMPLEFIN_ACCESS_URL=

# Failure alerts (optional). Leave blank for macOS notifications only.
# Gmail: Google Account > Security > 2-Step Verification > App passwords, then paste it here.
NOTIFY_EMAIL=
SMTP_USER=
SMTP_PASSWORD=

# Outside watchdog (optional): a healthchecks.io ping URL. The sync checks in on every run;
# if a check-in is missed, healthchecks.io emails you even when this Mac is off.
HEALTHCHECK_URL=
